{
  "name": "gov-br-react-ui",
  "version": "0.0.8-beta",
  "description": "Biblioteca de componentes React seguindo o Design System do Governo Federal",
  "type": "module",
  "keywords": [
    "react",
    "components",
    "design-system",
    "govbr",
    "governo-federal",
    "ui",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
