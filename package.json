  },
  "bugs": {
    "url": "https://github.com/atejap05/gov-br-react-ui/issues"
  },
  "homepage": "https://github.com/atejap05/gov-br-react-ui#readme",
  "main": "dist/index.umd.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
